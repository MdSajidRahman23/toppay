{
  "manifest_version": 3,
  "name": "TopPay Smart Decision Assistant",
  "version": "3.18.3",
  "description": "Auto-scans full audit details on open, auto-captures & reads Salary Slip / bKash Statement PDFs, scans NID front/back + MRZ + PDF417 with Adaptive OCR & Multi-Layer Tamper/Fake Detection, checks dual IMEI & phones, and applies SOP rules. Also beeps when new Pending Check/Review cases arrive.",
  "host_permissions": [
    "https://web.toppaybd.com/*",
    "https://toppay-zeta.vercel.app/*",
    "https://*/*"
  ],
  "permissions": [
    "storage",
    "alarms",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.toppaybd.com/*"
      ],
      "js": [
        "injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.toppaybd.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "lib/statement-core.js",
        "engine-local.js",
        "core.js",
        "content.js",
        "alert.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ocr.html",
        "lib/*"
      ],
      "matches": [
        "https://web.toppaybd.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "TopPay Audit Alert",
    "default_popup": "alert-popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
